rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /reports/{reportId} {
      allow read, create, update: if true;
    }
    match /announcements/{announcementId} {
      allow read, create, update: if true;
    }
  }
}
